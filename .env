# 애플리케이션 기본 설정
APP_NAME="VibeTrading Backend"
API_V1_PREFIX="/api/v1"

# Upbit API 키 (실제 키로 교체하세요)
UPBIT_ACCESS_KEY="CHANGE_ME"
UPBIT_SECRET_KEY="CHANGE_ME"

# 데이터베이스 및 리소스 경로
DATABASE_URL="sqlite:///./indicators.db"
POSITIONS_CONFIG_PATH="./positions_config.json"

# 환율 및 로깅 설정
USD_KRW_RATE=1350.0
LOG_LEVEL="INFO"
